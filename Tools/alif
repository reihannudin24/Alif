#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="$(sed -n 's/^m_EditorVersion: //p' "$ROOT/ProjectSettings/ProjectVersion.txt" || echo "6000.6.0f1")"
COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    status)
        unity doctor --format json
        unity pipeline list --format json
        ;;
    validate)
        unity run "$ROOT" --editor-version "$VERSION" --timeout 600 -- \
            -executeMethod Alif.EditorTools.AlifAdventureBuilder.Build -logFile -
        unity run "$ROOT" --editor-version "$VERSION" --timeout 600 -- \
            -executeMethod Alif.EditorTools.AlifLevelValidator.ValidateAll -logFile -
        ;;
    lint-level)
        unity run "$ROOT" --editor-version "$VERSION" --timeout 600 -- \
            -executeMethod Alif.EditorTools.AlifLevelValidator.ValidateAll -logFile -
        ;;
    apply-variant-c)
        unity run "$ROOT" --editor-version "$VERSION" --timeout 600 -- \
            -executeMethod Alif.EditorTools.AlifAdventureBuilder.ApplyVariantC -logFile -
        ;;
    generate-tile-rpg)
        SPEC="${1:-Assets/AI/TileRpg/Specs/sample-world.json}"
        unity run "$ROOT" --editor-version "$VERSION" --timeout 600 -- \
            -executeMethod Alif.EditorTools.AiTileRpgBuilder.Generate \
            -aiTileRpgSpec "$SPEC" -logFile -
        ;;
    test-edit|test-play)
        mkdir -p "$ROOT/Logs/TestResults"
        MODE="EditMode"
        [ "$COMMAND" = "test-play" ] && MODE="PlayMode"
        unity test "$ROOT" --editor-version "$VERSION" --mode "$MODE" \
            --report-format nunit,junit --output "$ROOT/Logs/TestResults/${MODE}.xml" --timeout 900
        ;;
    test-all)
        "$ROOT/Tools/alif" test-edit
        "$ROOT/Tools/alif" test-play
        ;;
    quick-check)
        echo "=== Validating TileRPG JSON specs ==="
        python3 -m json.tool "$ROOT/Assets/AI/TileRpg/Specs/sample-world.json" > /dev/null
        echo "=== Running EditMode unit tests ==="
        "$ROOT/Tools/alif" test-edit
        echo "=== Running Level integrity linting ==="
        "$ROOT/Tools/alif" lint-level
        echo "=== Quick check completed successfully ==="
        ;;
    build-web)
        unity build "$ROOT" --editor-version "$VERSION" --target WebGL \
            --execute-method Alif.EditorTools.AlifAdventureBuilder.BuildWeb \
            --output-path "$ROOT/Build/WebGL" --allow-dirty-build --timeout 1800
        ;;
    build-mac)
        unity build "$ROOT" --editor-version "$VERSION" --target StandaloneOSX \
            --execute-method Alif.EditorTools.AlifAdventureBuilder.BuildMac \
            --output-path "$ROOT/Build/macOS/Alif.app" --allow-dirty-build --timeout 1800
        ;;
    find-repo)
        python3 "$ROOT/Tools/find-repo/find_repo.py" "$@"
        ;;
    agent)
        python3 "$ROOT/Tools/alif-agent/cli.py" "$@"
        ;;
    asset-gen)
        python3 "$ROOT/Tools/alif-asset-gen/cli.py" "$@"
        ;;
    find-assets)
        python3 "$ROOT/Tools/find-assets/find_assets.py" "$@"
        ;;
    *)
        echo "Usage: ./Tools/alif {status|validate|lint-level|apply-variant-c|generate-tile-rpg [spec]|test-edit|test-play|test-all|quick-check|build-web|build-mac|find-repo|find-assets|agent|asset-gen}"
        [ "$COMMAND" = "help" ] || exit 2
        ;;
esac
