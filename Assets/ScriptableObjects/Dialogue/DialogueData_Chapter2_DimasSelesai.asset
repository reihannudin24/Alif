  m_Script: {fileID: 11500000, guid: 7e7e8abb4e4b043c08377bbf1eb960b6, type: 3}
  m_Name: DialogueData_Chapter2_DimasSelesai
  m_EditorClassIdentifier: Assembly-CSharp::Alif.Dialogue.DialogueData
  Lines:
  - SpeakerName: Dimas
    SpeakerData: {fileID: 11400000, guid: b029c455191ad4c42b0dcaa19f995a4c, type: 2}
    Text: Pengajuan pinjolnya tetap batal. Panitia sudah menyetujui cicilan biaya
      tanpa tambahan, dan keluargaku membantu sisanya sebagai qard hasan tertulis.
    Choices: []
    NextLineIndex: -1
  - SpeakerName: Alif
    SpeakerData: {fileID: 11400000, guid: 888c6b6b867d8485ab88489f284792c2, type: 2}
    Text: Mantap. Simpan catatannya, kembalikan pokok sesuai jadwal, dan kabari lebih
      awal kalau ada perubahan.
    Choices: []
    NextLineIndex: -1
  - SpeakerName: Dimas
    SpeakerData: {fileID: 11400000, guid: b029c455191ad4c42b0dcaa19f995a4c, type: 2}
    Text: "Siap. Sekarang aku ngerti: menolak pinjol saja belum cukup\u2014aku juga
      harus punya anggaran dan jalur bantuan yang jelas."
    Choices: []
    NextLineIndex: -1
  OnCompleteEventId: chapter2.dimas_followup
