  m_Name: DialogueData_WarungLihatMenu
  m_EditorClassIdentifier: Assembly-CSharp::Alif.Dialogue.DialogueData
  Lines:
  - SpeakerName: Alif
    SpeakerData: {fileID: 11400000, guid: 888c6b6b867d8485ab88489f284792c2, type: 2}
    Text: Aku cek menu Warung Bu Siti dulu.
    Choices: []
    NextLineIndex: -1
  - SpeakerName: Menu Warung Bu Siti
    SpeakerData: {fileID: 0}
    Text: "AYAM GEPREK + NASI \u2014 Rp18.000\nNASI TELUR \u2014 Rp12.000\nES TEH
      \u2014 Rp6.000\n\nPilih pesananmu di kasir."
    Choices: []
    NextLineIndex: -1
  - SpeakerName: Bu Siti
    SpeakerData: {fileID: 11400000, guid: 30e3e15dad8d8407bb8e3f8221f9e816, type: 2}
    Text: Kalau sudah memilih, datang ke kasir ya, Alif. Ibu catat pesananmu di sana.
    Choices: []
    NextLineIndex: -1
