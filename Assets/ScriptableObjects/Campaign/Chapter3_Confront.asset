  m_Script: {fileID: 11500000, guid: 7e7e8abb4e4b043c08377bbf1eb960b6, type: 3}
  m_Name: Chapter3_Confront
  m_EditorClassIdentifier: Assembly-CSharp::Alif.Dialogue.DialogueData
  Lines:
  - SpeakerName: Raka
    SpeakerData: {fileID: 11400000, guid: bbc7ebd26e1234001ad59f735c01e6d7, type: 2}
    Text: Aku hampir mengira keberuntungan adalah rencana keuangan.
    Choices: []
    NextLineIndex: -1
  - SpeakerName: Alif
    SpeakerData: {fileID: 11400000, guid: 888c6b6b867d8485ab88489f284792c2, type: 2}
    Text: Kita sudah membaca syaratnya. Bayangan promosi itu masih menekan, tetapi
      kita bisa menolaknya.
    Choices: []
    NextLineIndex: -1
  - SpeakerName: ALIF
    SpeakerData: {fileID: 11400000, guid: 888c6b6b867d8485ab88489f284792c2, type: 2}
    Text: Arena ini menggambarkan godaan, bukan orang sungguhan. Dekati saat boss
      pulih. J untuk serang; Spasi untuk menghindar.
    Choices: []
    NextLineIndex: -1
  OnCompleteEventId: 
