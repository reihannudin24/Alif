  m_Script: {fileID: 11500000, guid: 7e7e8abb4e4b043c08377bbf1eb960b6, type: 3}
  m_Name: Chapter4_Intro
  m_EditorClassIdentifier: Assembly-CSharp::Alif.Dialogue.DialogueData
  Lines:
  - SpeakerName: Naya
    SpeakerData: {fileID: 11400000, guid: 047c6120d2a134db8a75c78182f2e37e, type: 2}
    Text: Aku membantu bazar warga. Ada barang yang disebut baru, tetapi beberapa
      pembeli menemukan kerusakan.
    Choices: []
    NextLineIndex: -1
  - SpeakerName: Alif
    SpeakerData: {fileID: 11400000, guid: 888c6b6b867d8485ab88489f284792c2, type: 2}
    Text: Jangan langsung menyebarkan tuduhan. Kita bandingkan barang, label, dan
      bukti pembeliannya.
    Choices: []
    NextLineIndex: -1
  OnCompleteEventId: 
